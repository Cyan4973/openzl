load("../../defs.bzl", "relative_headers", "zs_binary", "zs_library", "zs_release_binary")

oncall("data_compression")

zs_library(
    name = "sao_graph",
    srcs = ["scenarios/sao_graph.c"],
    headers = {"benchmark/unitBench/scenarios/sao_graph.h": "scenarios/sao_graph.h", "scenarios/sao_graph.h": "scenarios/sao_graph.h"},
    deps = [
        "../..:zstronglib",
        "fbsource//third-party/benchmark:benchmark",
    ],
)

zs_binary(
    name = "unitBench",
    srcs = glob(["**/*.c"]),
    headers = relative_headers(
        glob([
            "**/*.h",
        ])
    )
    | {
        header: header
        for header in [
            "benchfn.h",
            "scenarios/codecs/bitSplit.h",
            "scenarios/codecs/delta.h",
            "scenarios/codecs/dispatch_by_tag.h",
            "scenarios/codecs/dispatch_string.h",
